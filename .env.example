# 第 3.3 章 LLM 客户端：CLIProxy 的 OpenAI 兼容接口。
# 在同目录 .env 中填写真实配置；.env 已被 Git 忽略。

# API 根地址，通常以 /v1 结尾；不要填写网页管理地址或 /chat/completions 完整路径。
LLM_BASE_URL=

# CLIProxy 配置中允许的客户端 API Key，不是登录上游服务的凭据。
# 如果你的代理没有启用认证，可填写非空占位值，例如 unused。
LLM_API_KEY=

# 填写 CLIProxy 实际提供、支持 Chat Completions 工具调用的模型 ID。
LLM_MODEL=
